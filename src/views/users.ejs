<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email (Username)</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(registeredUser=> { %>
                    <tr>
                        <td>
                            <%= registeredUser.name %>
                        </td>
                        <td>
                            <%= registeredUser.email %>
                        </td>
                        <td>
                            <%= registeredUser.role_name %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>

        <p><a href="/dashboard">Back to Dashboard</a></p>
    </main>
    <%- include('partials/footer') %>